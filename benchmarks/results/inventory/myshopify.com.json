      "raw_html": "<!DOCTYPE html>\n<html class=\"shop-404\" lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Store unavailable</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"referrer\" content=\"never\">\n  <link rel=\"shortcut icon\" type=\"image/x-icon\" href=\"//cdn.shopify.com/shopifycloud/storefront/assets/favicon-418d2057.png\">\n\n  <style>\n    @font-face {\n      font-family: 'Shopify Sans Regular';\n      font-display: swap;\n      font-style: normal;\n      font-weight: 400;\n      src: url('https://cdn.shopify.com/s/files/1/0458/4836/3030/files/ShopifySans-Regular.woff2?v=1674610915') format('woff2');\n    }\n\n    @font-face {\n      font-family: 'Shopify Sans Medium';\n      font-display: swap;\n      font-style: normal;\n      font-weight: 500;\n      src: url('https://cdn.shopify.com/s/files/1/0458/4836/3030/files/ShopifySans-Medium.woff2?v=1674610916') format('woff2');\n    }\n\n    :root {\n      --background: #000f0d;\n      --text-primary: #f6f7f6;\n      --text-secondary: #b6bbb7;\n      --border: rgba(246, 247, 246, 0.22);\n      --border-strong: rgba(246, 247, 246, 0.9);\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      min-height: 100%;\n      margin: 0;\n    }\n\n    body {\n      background: var(--background);\n      color: var(--text-primary);\n      font-family: 'Shopify Sans Regular', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n      -webkit-font-smoothing: antialiased;\n      text-rendering: optimizeLegibility;\n    }\n\n    a {\n      color: inherit;\n    }\n\n    .page {\n      min-height: 100vh;\n      overflow-x: hidden;\n      padding: 64px 16px;\n    }\n\n    .hero {\n      max-width: 900px;\n      margin: 0 auto;\n      text-align: center;\n    }\n\n    .breadcrumb {\n      align-items: center;\n      display: inline-flex;\n      gap: 8px;\n      margin-bottom: 38px;\n      color: var(--text-primary);\n      font-family: 'Shopify Sans Medium', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n      font-size: 18px;\n      line-height: 1;\n      text-decoration: none;\n    }\n\n    .breadcrumb-arrow {\n      font-size: 25px;\n      font-weight: 400;\n      line-height: 0.8;\n      transition: transform 0.2s ease;\n    }\n\n    .breadcrumb:hover .breadcrumb-arrow {\n      transform: translateX(-4px);\n    }\n\n    .headline {\n      margin: 0;\n      color: var(--text-primary);\n      font-family: 'Shopify Sans Regular', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n      font-size: 38px;\n      font-weight: 400;\n      letter-spacing: -0.045em;\n      line-height: 1.08;\n      text-wrap: balance;\n    }\n\n    .subtitle {\n      margin: 18px auto 0;\n      max-width: 720px;\n      color: var(--text-secondary);\n      font-size: clamp(18px, 1.45vw, 22px);\n      line-height: 1.45;\n      text-wrap: balance;\n    }\n\n    .actions {\n      align-items: center;\n      display: flex;\n      flex-direction: column;\n      gap: 22px;\n      justify-content: center;\n      margin-top: 26px;\n    }\n\n    .refresh-form {\n      margin: 0;\n    }\n\n    .button {\n      appearance: none;\n      align-items: center;\n      background: transparent;\n      border: 1px solid var(--border-strong);\n      border-radius: 999px;\n      color: var(--text-primary);\n      cursor: pointer;\n      display: inline-flex;\n      font-family: 'Shopify Sans Medium', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n      font-size: 18px;\n      justify-content: center;\n      line-height: 1.2;\n      max-width: 100%;\n      padding: 10px 22px;\n      text-decoration: none;\n      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;\n    }\n\n    .button:hover {\n      background: var(--text-primary);\n      border-color: var(--text-primary);\n      color: var(--background);\n    }\n\n    .breadcrumb:focus-visible,\n    .button:focus-visible,\n   