d-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n      text-align: center;\n    }\n\n    .legacy-support-card {\n      max-width: 780px;\n      text-align: center;\n    }\n\n    .cta-link {\n      color: var(--text-primary);\n      font-family: 'Shopify Sans Medium', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n      font-size: 18px;\n      margin-top: 14px;\n    }\n\n    .link,\n    .link-dark {\n      color: var(--text-primary);\n      text-decoration: underline;\n      text-underline-offset: 4px;\n    }\n\n    @media screen and (min-width: 901px) {\n      .page {\n        padding: 138px 6vw 84px;\n      }\n\n      .headline {\n        font-size: clamp(44px, 4.15vw, 64px);\n        letter-spacing: -0.055em;\n        line-height: 1.05;\n      }\n\n      .subtitle {\n        line-height: 1.4;\n      }\n\n      .actions {\n        flex-direction: row;\n        gap: 36px;\n      }\n\n      .button {\n        font-size: 20px;\n        line-height: 1;\n        min-height: 60px;\n        padding: 0 28px;\n        white-space: nowrap;\n      }\n\n      .button--wide {\n        min-width: 350px;\n      }\n\n      .free-trial-link {\n        font-size: 20px;\n      }\n\n      .support-card,\n      .legacy-support-card,\n      .legacy-cta-list {\n        margin-top: 130px;\n      }\n\n      .support-card {\n        align-items: center;\n        flex-direction: row;\n        gap: 48px;\n        justify-content: space-between;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .breadcrumb-arrow,\n      .button {\n        transition: none;\n      }\n\n      .breadcrumb:hover .breadcrumb-arrow {\n        transform: none;\n      }\n    }\n  </style>\n<meta name=\"shopify-y\" content=\"05ff9f93-03e2-4942-9d20-d1f628f08e8b\"><meta name=\"shopify-s\" content=\"682c1be9-718e-43a6-b885-619d69c727d3\"><meta name=\"new-cookie-storage-activated\" content=\"f\"></head>\n\n<body>\n  <main class=\"page\">\n    <section class=\"hero\" aria-labelledby=\"hero-text\">\n      <a class=\"breadcrumb\" href=\"https://www.shopify.com/?utm_source=ExpiredDomainLink&utm_medium=textlink&utm_campaign=breadcrumb\">\n        <span class=\"breadcrumb-arrow\" aria-hidden=\"true\">\u2190</span>\n        <span>Shopify</span>\n      </a>\n\n      <div id=\"shop-not-found\">\n        <h1 class=\"headline\" id=\"hero-text\">This store is currently unavailable.</h1>\n      </div>\n\n      <div id=\"did-you-mean-msg\" style=\"display: none;\">\n        <h1 class=\"headline\">\n          Did you mean <a class=\"did-you-mean-link\" id=\"did-you-mean-link\"></a>?\n        </h1>\n      </div>\n\n      <script type=\"text/javascript\" nonce=\"rk/EdR1227h9JJAOqVdC4gspKA8OfnAmBuq/OP+an+g=\">\n        (function() {\n          var hostname = window.location.hostname;\n          var re = /\\.(shopify|shopifyadmin)\\.com$/;\n\n          if (hostname == 'checkout.shopify.com' || hostname == 'app.shopify.com' || !hostname.match(re)) {\n            return;\n          }\n\n          var didYouMeanLink = document.getElementById('did-you-mean-link');\n          var didYouMeanMessage = document.getElementById('did-you-mean-msg');\n          var shopNotFoundMessage = document.getElementById('shop-not-found');\n\n          if (!didYouMeanLink || !didYouMeanMessage || !shopNotFoundMessage) {\n            return;\n          }\n\n          var myshopifyDomain = encodeURI(hostname.replace(re, '.myshopify.com'));\n          var href = encodeURI(window.location.href.replace(hostname, myshopifyDomain));\n\n          didYouMeanLink.setAttribute('href', href);\n          didYouMeanLink.textContent = myshopifyDomain;\n          shopNotFoundMessage.style.display = 'none';\n          didYouMeanMessage.style.display = 'block';\n        })();\n      </script>\n\n        <div class=\"actions\">\n\n          <a class=\"free-trial-link\" id=\"free-trial\" target=\"_blank\" rel=\"noopener\" href=\"https://www.shopify.com/?utm_source=ExpiredDomainLink&utm_medium=button