{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand AI-Readiness Audit Report",
  "type": "object",
  "required": [
    "site",
    "audited_at",
    "summary",
    "findings"
  ],
  "properties": {
    "site": {
      "type": "string"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_findings",
        "critical",
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "total_findings": {
          "type": "integer"
        },
        "critical": {
          "type": "integer"
        },
        "high": {
          "type": "integer"
        },
        "medium": {
          "type": "integer"
        },
        "low": {
          "type": "integer"
        },
        "discoverability_findings": {
          "type": "integer"
        },
        "engagement_findings": {
          "type": "integer"
        },
        "citability_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional additive field. 0-100 AI-Citability Score derived from the final findings list. Formula documented in references/citability-score.md."
        },
        "citability_score_unavailable": {
          "type": "string",
          "description": "Optional additive field. Present INSTEAD of citability_score when no page could be read, so an unreadable crawl cannot be mistaken for a healthy site."
        }
      }
    },
    "access_summary": {
      "type": "object",
      "description": "Optional additive field describing whether enough readable pages were available to interpret evidence-dependent checks.",
      "required": ["pages_sampled", "readable_pages", "status_counts", "limited"],
      "properties": {
        "pages_sampled": { "type": "integer", "minimum": 0 },
        "readable_pages": { "type": "integer", "minimum": 0 },
        "status_counts": { "type": "object" },
        "limited": { "type": "boolean" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "severity",
          "status",
          "confidence",
          "impact",
          "evidence",
          "severity_rationale",
          "suggested_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "crawlability",
              "render-gap",
              "structured-data",
              "fact-extractability",
              "freshness",
              "internal-consistency",
              "corroboration",
              "entity-disambiguation",
              "orientation",
              "navigation",
              "personalization-readiness",
              "citation-omission",
              "citation-misattribution",
              "citation-staleness",
              "citation-contradiction"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "description": "Optional additive field. Carried through from the CandidateFinding contract and used as the secondary sort key after severity. Mirrors severity unless a specialist skill supplies a distinct value, so consumers may treat it as equal to severity when absent."
          },
          "evidence": {
            "type": "string"
          },
          "severity_rationale": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[a-f0-9]{12}$"
            }
          },
          "evidence_details": {
            "type": "object",
            "required": [
              "evidence_id",
              "url",
              "observation",
              "method",
              "timestamp",
              "confidence"
            ],
            "properties": {
              "evidence_id": {"type": "string", "pattern": "^E-[a-f0-9]{12}$"},
              "url": {"type": "string"},
              "observation": {"type": "string"},
              "method": {"type": "string"},
              "timestamp": {"type": "string", "format": "date-time"},
              "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
              ,"evidence_origin": {"type": "string", "enum": ["on-site", "external"]}
              ,"external_evidence_ids": {"type": "array", "items": {"type": "string"}}
            }
          },
          "source_skill": {
            "type": "string"
          },
          "suggested_action": {
            "type": "object",
            "required": [
              "how_to_fix",
              "priority",
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "how_to_fix": {
                "type": "string"
              },
              "beyond_defect": {
                "type": "boolean"
              },
              "fix_snippet": {
                "type": "string",
                "description": "Optional additive field. Ready-to-paste <script type=\"application/ld+json\"> block pre-populated from observed ground_truth. Present only for structured-data findings where the audit held enough real data to fill the entity's identifying fields."
              },
              "expected_benefit": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "likely-risk",
              "proactive"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "fingerprint": {
            "type": "string"
          },
          "source_skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fix_prompt": {
            "type": "object",
            "description": "Optional additive evidence-derived implementation brief; recommendation only.",
            "required": ["target", "prompt", "validation"],
            "properties": {
              "target": {"type": "string", "const": "coding_agent"},
              "prompt": {"type": "string"},
              "validation": {"type": "array", "items": {"type": "string"}},
              "finding_id": {"type": "string"},
              "title": {"type": "string"},
              "status": {"type": "string", "enum": ["confirmed", "likely-risk", "proactive"]},
              "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
              "role": {"type": "string"},
              "problem": {"type": "string"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}},
              "root_cause": {"type": "string"},
              "task": {"type": "string"},
              "constraints": {"type": "array", "items": {"type": "string"}},
              "suggested_action": {"type": "object"}
            }
          }
        }
      }
    },
    "fix_plan": {
      "type": "array",
      "description": "Optional additive prioritized fix prompts derived only from finalized findings and evidence refs.",
      "items": {
        "type": "object",
        "required": ["finding_id", "execution_order", "priority", "reason", "prompt"],
        "properties": {
          "finding_id": {"type": "string"},
          "execution_order": {"type": "integer", "minimum": 1},
          "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "reason": {"type": "string"},
          "prompt": {"type": "string"},
          "validation": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "proactive_recommendations": {
      "type": "array",
      "description": "Optional additive field (schema is a floor, not a ceiling). Improvements suggested even where no defect was detected.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "rationale",
          "suggested_action"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "suggested_action": {
            "type": "object",
            "required": [
              "summary",
              "priority"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "how_to_fix": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "evidence_ledger": {
      "type": "array",
      "description": "Stable, structured observations referenced by finding evidence_refs.",
      "items": {
        "type": "object",
        "required": ["evidence_id", "url", "observation", "method", "timestamp", "confidence"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^E-[a-f0-9]{12}$"},
          "url": {"type": "string"},
          "observation": {"type": "string"},
          "method": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
          ,"evidence_origin": {"type": "string", "enum": ["on-site", "external"]}
          ,"source_urls": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "external_discovery": {
      "type": "object",
      "required": ["source", "network_lookup_performed", "evidence_refs"],
      "properties": {
        "source": {"const": "agent-supplied"},
        "network_lookup_performed": {"const": false},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assessments": {
      "type": "array",
      "description": "Checks that passed or could not be assessed without turning missing evidence into findings.",
      "items": {
        "type": "object",
        "required": ["check", "status", "result", "reason"],
        "properties": {
          "check": {"type": "string"},
          "status": {"type": "string", "enum": ["confirmed", "likely-risk", "inconclusive", "not-assessed", "proactive"]},
          "result": {"type": "string", "enum": ["passed", "assessed", "limited", "not-assessed"]},
          "reason": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
