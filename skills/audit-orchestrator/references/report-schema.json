{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand AI-Readiness Audit Report",
  "type": "object",
  "required": ["site", "audited_at", "summary", "findings"],
  "properties": {
    "site": { "type": "string" },
    "audited_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium", "low"],
      "properties": {
        "total_findings": { "type": "integer" },
        "critical": { "type": "integer" },
        "high": { "type": "integer" },
        "medium": { "type": "integer" },
        "low": { "type": "integer" },
        "discoverability_findings": { "type": "integer" },
        "engagement_findings": { "type": "integer" },
        "citability_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional additive field. 0-100 AI-Citability Score derived from the final findings list. Formula documented in references/citability-score.md."
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "evidence", "suggested_action"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3}$" },
          "title": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "crawlability", "render-gap", "structured-data", "fact-extractability",
              "freshness", "internal-consistency", "corroboration", "entity-disambiguation",
              "orientation", "navigation", "personalization-readiness",
              "citation-omission", "citation-misattribution", "citation-staleness", "citation-contradiction"
            ]
          },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "impact": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "Optional additive field. Carried through from the CandidateFinding contract and used as the secondary sort key after severity. Mirrors severity unless a specialist skill supplies a distinct value, so consumers may treat it as equal to severity when absent."
          },
          "evidence": { "type": "string" },
          "source_skill": { "type": "string" },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "properties": {
              "summary": { "type": "string" },
              "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "how_to_fix": { "type": "string" },
              "beyond_defect": { "type": "boolean" },
              "fix_snippet": {
                "type": "string",
                "description": "Optional additive field. Ready-to-paste <script type=\"application/ld+json\"> block pre-populated from observed ground_truth. Present only for structured-data findings where the audit held enough real data to fill the entity's identifying fields."
              }
            }
          }
        }
      }
    },
    "proactive_recommendations": {
      "type": "array",
      "description": "Optional additive field (schema is a floor, not a ceiling). Improvements suggested even where no defect was detected.",
      "items": {
        "type": "object",
        "required": ["title", "rationale", "suggested_action"],
        "properties": {
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "properties": {
              "summary": { "type": "string" },
              "priority": { "type": "string", "enum": ["high", "medium", "low"] },
              "how_to_fix": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
